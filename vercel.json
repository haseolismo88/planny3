{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "api/dialogue.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "^/api/dialogue/?$", "dest": "/api/dialogue.js" },
    { "src": "^/$", "dest": "/index.html" },
    { "handle": "filesystem" }
  ]
}
